# Streamlit Cloud Secrets Template
# Copy these keys into Streamlit Cloud > App > Settings > Secrets

# Optional providers
ANTHROPIC_API_KEY = "your-anthropic-key"

# Default OpenAI key used when user doesn't provide their own
OPENAI_CBS_API_KEY = "your-default-openai-key"

# Optional direct OpenAI key (used if OPENAI_CBS_API_KEY not set)
OPENAI_API_KEY = "your-openai-key"

# Optional custom base URL
OPENAI_BASE_URL = "https://cbsai.business.columbia.edu/api/v1"

# Optional enrichment provider
TAVILY_API_KEY = "your-tavily-key"

