# Sentry error tracking (optional — leave blank to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Select provider: anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic config
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI-compatible config
OPENAI_API_KEY=your_openai_key_here
# Optional fallback key used in deployed Streamlit when user leaves key blank
OPENAI_CBS_API_KEY=
# Optional override. If unset, defaults to:
# https://cbsai.business.columbia.edu/api/v1
# OPENAI_BASE_URL=https://cbsai.business.columbia.edu/api/v1

# Optional data enrichment toggles
ENABLE_YAHOO=true
ENABLE_TAVILY=true

# Tavily enrichment (required only if ENABLE_TAVILY=true)
TAVILY_API_KEY=your_tavily_key_here
# Optional: max result items per Tavily query
TAVILY_MAX_RESULTS=3
# Optional: max chars per Tavily snippet
TAVILY_SNIPPET_CHARS=220
# Optional: hard cap for full enrichment block
ENRICHMENT_MAX_CHARS=3500
# Optional: per-section caps for cleaner routing
MAX_MARKET_SECTION_CHARS=900
MAX_EXTERNAL_COMPANY_SECTION_CHARS=1200
MAX_EXTERNAL_INDUSTRY_SECTION_CHARS=1200
MAX_EXTERNAL_RISKS_SECTION_CHARS=1200

# LLM budget guardrails
# Per-agent context char cap before model call
MAX_AGENT_CONTEXT_CHARS=7000
# Optional per-agent overrides
MAX_CONTEXT_DCF_CHARS=7000
MAX_CONTEXT_RISK_CHARS=7000
MAX_CONTEXT_EARNINGS_CHARS=7000
MAX_CONTEXT_COMPETITIVE_CHARS=7000
MAX_CONTEXT_PATTERN_CHARS=7000
# Per-agent max output tokens
MAX_AGENT_OUTPUT_TOKENS=1200
# Synthesis input cap (combined agent reports)
SYNTHESIS_INPUT_MAX_CHARS=14000
# Per-agent report cap inside synthesis input
SYNTHESIS_REPORT_MAX_CHARS=3200
# Synthesis max output tokens
MAX_SYNTHESIS_OUTPUT_TOKENS=1500

